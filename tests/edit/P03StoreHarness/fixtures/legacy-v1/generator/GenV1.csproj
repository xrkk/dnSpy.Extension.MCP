<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>P03StoreHarness</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416;CS8600;CS8602;CS8604</NoWarn>
    <ProductDir>/tmp/dnspy-t003-r01-build/Extensions/dnSpy.Extension.MCP/bin/Release/net10.0-windows/</ProductDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="dnSpy.Extension.MCP.x"><HintPath>$(ProductDir)dnSpy.Extension.MCP.x.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="dnlib"><HintPath>$(ProductDir)dnlib.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="CopyDeps" AfterTargets="Build">
    <ItemGroup><Dep Include="$(ProductDir)*.dll" /></ItemGroup>
    <Copy SourceFiles="@(Dep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
