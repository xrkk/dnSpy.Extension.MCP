<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AssemblyName>P03StoreHarness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dnSpy.Extension.MCP.csproj" />
  </ItemGroup>

  <!-- P05 compile-frontend probe: the stub provider implements the public
       dnSpy compiler contracts, so the harness needs those contract refs. -->
  <ItemGroup>
    <Reference Include="dnSpy.Contracts.DnSpy">
      <HintPath>$(DNSPY_CONTRACTS_DIR)dnSpy.Contracts.DnSpy.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- T003-R03 legacy v1 fixtures: committed real v1 packages plus their
       regeneration generator.  The generator is documentation/build utility
       source, never compiled into the harness. -->
  <ItemGroup>
    <Compile Remove="fixtures/**" />
    <None Include="fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
