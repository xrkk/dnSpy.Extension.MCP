<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dnSpy.Feasibility.Spike.x</AssemblyName>
    <RootNamespace>DnSpy.Feasibility.Spike</RootNamespace>
    <DnSpyRoot Condition="'$(DnSpyRoot)' == ''">/home/adminn/tmp/dnSpyEx</DnSpyRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);Fixture/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="dnSpy.Contracts.DnSpy">
      <HintPath>$(DnSpyRoot)/dnSpy/dnSpy.Contracts.DnSpy/bin/Release/net48/dnSpy.Contracts.DnSpy.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="dnlib">
      <HintPath>$(DnSpyRoot)/dnSpy/dnSpy.Contracts.DnSpy/bin/Release/net48/dnlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
