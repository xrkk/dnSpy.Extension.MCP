<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- dnlib from the dnSpyEx checkout used by the extension build (same metadata reader
         the product itself uses, so token/offset semantics cannot drift from production).
         Default hint path works from the repo layout; override with -p:DNLIB_HINT_PATH. -->
    <Reference Include="dnlib">
      <HintPath>$(DNLIB_HINT_PATH)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
