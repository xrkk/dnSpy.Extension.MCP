{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dnspy.debug.test.v1",
  "title": "dnspy.debug.test.v1 result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit_sha",
    "case_id",
    "started_utc",
    "finished_utc",
    "status",
    "exit_code",
    "assertions",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "dnspy.debug.test.v1"
    },
    "repository": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^ACC-[0-9]{3}$"
    },
    "started_utc": {
      "type": "string"
    },
    "finished_utc": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "status",
          "expected",
          "actual",
          "evidence_paths"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:|[/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!result\\.json$).+"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:|[/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!result\\.json$).+"
      }
    }
  }
}
